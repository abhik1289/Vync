# PostgreSQL connection string (Prisma 7 driver adapter)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vync"

# Server
NODE_ENV="development"
PORT=5000
API_URL="http://localhost:5000"
CLIENT_URL="http://localhost:3000"

# JWT secrets (use strong random values in production, e.g. `openssl rand -base64 48`)
ACCESS_TOKEN_SECRET="dev_access_token_secret_change_me_min_32_chars"
REFRESH_TOKEN_SECRET="dev_refresh_token_secret_change_me_min_32_chars"
JWT_SECRET="dev_jwt_secret_change_me_min_32_chars"

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
